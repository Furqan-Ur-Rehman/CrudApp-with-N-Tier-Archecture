@* 
The below @section Scripts{} represent the all links of jquery and javascript 
which is placed in _Layout.cshtml master file, So no need to place below. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript">
        $(document).ready(function(){
            $("#open").click(function(){
                $("#open").hide();
                $("#close").show();
                $("#password").attr("type", "text");
            });
            $("#close").click(function(){
                $("#close").hide();
                $("#open").show();
                $("#password").attr("type", "password");
            });

            $("#confirmopen").click(function(){
                $("#confirmopen").hide();
                $("#confirmclose").show();
                $("#confirmpassword").attr("type", "text");
            });
            $("#confirmclose").click(function(){
                $("#confirmclose").hide();
                $("#confirmopen").show();
                $("#confirmpassword").attr("type", "password");
            });
        });
    </script>
}
