@model N_Tier_Architecture.Areas.Admin.Controllers.EditUserRoleViewModel

<h3>Edit Roles for @Model.Email</h3>
<form asp-action="Edit">
    <input type="hidden" asp-for="UserId" />
    <table class="table">
        <thead>
            <tr>
                <th>Role</th>
                <th>Assigned</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Roles?.Count; i++)
            {
                <tr>
                    <td>@Model.Roles[i].RoleName</td>
                    <td>
                        <input asp-for="Roles[i].IsAssigned" type="checkbox" />
                        <input asp-for="Roles[i].RoleName" type="hidden" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit" class="btn btn-success">Save Changes</button>
</form>