@model N_Tier_Architecture_Models.ViewModels.ProductVM

@{
	ViewData["Title"] = "Edit";
}
<hr />
<div class="container" style="margin:auto">
	<div class="row" style="margin-left:160px !important; margin-right:-50px !important;">
		<h4>Update Product</h4>
		<form asp-action="Edit" enctype="multipart/form-data">

			<div class="row">
				<div class="col-md-4">
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>
					<input asp-for="Id" type="hidden" class="form-control" />
					<div class="form-group">
						<label asp-for="Name" class="control-label"></label>
						<input asp-for="Name" class="form-control" />
						<span asp-validation-for="Name" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-4">
					<div class="form-group">
						<label asp-for="Description" class="control-label"></label>
						<input asp-for="Description" class="form-control" />
						<span asp-validation-for="Description" class="text-danger"></span>
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-md-4">
					<div class="form-group">
						<label asp-for="Price" class="control-label"></label>
						<input asp-for="Price" class="form-control" />
						<span asp-validation-for="Price" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-4">
					<!-- Product Category Dropdown -->
					<div class="form-group">
						<label asp-for="CategoryId" class="control-label"></label>
						<select asp-for="CategoryId" class="form-control" asp-items="Model.CategoryList">
							<option>---------------------Select Category------------------</option>
						</select>
					</div>
				</div>
			</div>
			<div class="row  mt-3">
				<div class="col-md-4">
					<!-- Product Photo (Image Upload) -->
					<div class="form-group">
						<label asp-for="Photo" class="control-label"></label>
						<input asp-for="Photo" id="chooseimage" class="form-control" />
						<span asp-validation-for="Photo" class="text-danger"></span>
					</div>
				</div>
				<div class="col-md-4 mb-3">
					<img src="~/images/@Url.Content(Model.ImageUrl)" id="previewimage" style="width:130px; height:130px; cursor:pointer; margin-left:50px; border:1px solid red; border-radius:10px; padding:10px; " alt="Image Preview" />
					<b style="color:red;">Image Preview</b>
				</div>
			</div>
			<div class="row">
				<div class="col-md-8">
					<div class="form-group">
						<input type="submit" value="Update" class="btn btn-primary form-control" />
					</div>
				</div>
			</div>
		</form>
		<div>
			<a asp-action="Index">Back to List</a>
		</div>
	</div>

</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	<script src="~/js/previewimage.js"></script>

}

